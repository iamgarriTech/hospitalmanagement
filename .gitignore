# secrets — see CLAUDE.md guarantee 12
.env
.env.*
!.env.example
*.pem
*.key

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
*.sqlite3

# node
node_modules/
.next/
out/
next-env.d.ts

# media / uploads (never in the repo)
backend/media/
backend/staticfiles/
# Emergency ward snapshots: synthetic in development, patient data in
# production. Never in the repository either way.
backend/snapshots/

# os / editor
.DS_Store
.idea/
.vscode/
*.swp
*~

# tooling caches
.ruff_cache/
.mypy_cache/
*.tsbuildinfo

# personal scratch — notes, screenshots and prompts that belong to whoever is
# working here rather than to the project. Kept out of the repository so a
# contributor's local clutter never lands in a pull request.
ignoreitllm
/scratch/
/notes/
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.pdf
