# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres. Local dev uses the Homebrew server on 5432 as the current user.
DATABASE_URL=postgres://garritech@localhost:5432/hms_dev

# Application DB role — deliberately cannot UPDATE/DELETE the audit log.
# Migrations run as the owner above; the app runs as this role in production.
APP_DATABASE_URL=postgres://hms_app:change-me@localhost:5432/hms_dev

# Frontend origin, same-origin behind the proxy in production
FRONTEND_ORIGIN=http://localhost:3000
